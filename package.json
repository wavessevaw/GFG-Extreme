{
  "name": "gfg-extreme-plugin",
  "version": "4.0.0-gfg.4-governor.0.0.1-beta.1",
  "description": "GFG Extreme pipeline orchestrator with per-profile Frame Generation backends, scaling, and shaders",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "check:generated-config": "python3 scripts/check_generated_config.py",
    "generate:i18n": "node scripts/manage-i18n.mjs --generate",
    "check:i18n": "node scripts/manage-i18n.mjs --check",
    "build": "python3 scripts/check_generated_config.py && node scripts/manage-i18n.mjs --check && node scripts/build-frontend.mjs",
    "watch": "python3 scripts/check_generated_config.py && node scripts/manage-i18n.mjs --generate && rollup -c -w",
    "package:local": "./scripts/package-local.sh --local-engine-repo ../engine",
    "package:local-engine": "./scripts/package-local.sh --local-engine-repo ../engine",
    "package:local-engine-fast": "./scripts/package-local.sh --local-engine-repo ../engine --native-only --64-bit-only",
    "dev:deploy": "./scripts/deploy-dev.sh",
    "dev:reload": "node scripts/reload-decky-plugin.mjs",
    "dev:frontend": "./scripts/deploy-dev.sh --frontend",
    "dev:backend": "./scripts/deploy-dev.sh --backend",
    "dev:backend:reload": "./scripts/deploy-dev.sh --backend --reload",
    "dev:engine": "./scripts/deploy-dev.sh --engine",
    "dev:all": "./scripts/deploy-dev.sh --all",
    "dev:host": "./scripts/deploy-dev.sh --host",
    "dev:flatpaks": "./scripts/deploy-dev.sh --flatpaks",
    "dev:e2e": "./scripts/deploy-dev.sh --e2e",
    "dev:prune-build-cache": "../engine/scripts/prune-build-cache.sh",
    "dev:prune-flatpak-cache": "../engine/scripts/prune-steamos-flatpak-cache.sh",
    "format:markdown": "prettier --write --config ../.prettierrc.json --ignore-path ../.prettierignore \"../**/*.md\"",
    "format:markdown:check": "prettier --check --config ../.prettierrc.json --ignore-path ../.prettierignore \"../**/*.md\"",
    "format:staged": "lint-staged --cwd .. --config ../lint-staged.config.mjs",
    "hooks:install": "../scripts/install-git-hooks.sh",
    "package:publish": "./scripts/publish-package.sh",
    "test": "python3 scripts/check_generated_config.py && python3 -m unittest discover -s tests -p 'test_*.py' && node scripts/manage-i18n.mjs --check && node --test tests/i18n-contract.test.mjs && vitest run",
    "test:backend": "python3 scripts/check_generated_config.py && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:i18n": "node scripts/manage-i18n.mjs --check && node --test tests/i18n-contract.test.mjs",
    "test:frontend": "node scripts/manage-i18n.mjs --check && node --test tests/i18n-contract.test.mjs && vitest run",
    "test:frontend:coverage": "node scripts/manage-i18n.mjs --check && node --test tests/i18n-contract.test.mjs && vitest run --coverage",
    "test:frontend:typecheck": "node scripts/manage-i18n.mjs --check && tsc --noEmit -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugeniosegala/MAKO.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "steam-machine",
    "deck",
    "lossless-scaling",
    "spatial-scaling",
    "frame-generation",
    "framegen",
    "shaders",
    "vkbasalt",
    "gfg-extreme"
  ],
  "author": "Eugenio Segala",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/eugeniosegala/MAKO/issues"
  },
  "homepage": "https://github.com/eugeniosegala/MAKO#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.22.5",
    "@rollup/rollup-linux-x64-musl": "4.22.5"
  },
  "remote_binary_bundling": true,
  "remote_binary": [

{
  "name": "gfg-extreme-plugin",
  "version": "3.3.3-candidate.1",
  "description": "GFG Extreme 3.0: frame generation on its own engine (GSF Kedavra in Gamescope), Autopilot, TDP Governor, Power Split and GPU clock ceiling for Steam Deck",
  "type": "module",
  "scripts": {
    "build": "node frontend/build.mjs",
    "test:backend": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:frontend": "node frontend/harness/smoke.mjs",
    "test": "npm run test:backend && npm run test:sandbox && npm run build && npm run test:frontend",
    "test:sandbox": "python3 -m sandbox.run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavessevaw/GFG-Extreme.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "steam-machine",
    "deck",
    "frame-generation",
    "framegen",
    "gfg-extreme",
    "kedavra",
    "gamescope"
  ],
  "author": "Eugenio Segala",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/wavessevaw/GFG-Extreme/issues"
  },
  "homepage": "https://github.com/wavessevaw/GFG-Extreme#readme",
  "devDependencies": {
    "esbuild": "0.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "playwright-core": "1.56.1"
  },
  "gfgPrerelease": true
}

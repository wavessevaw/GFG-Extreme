      "url": "https://github.com/eugeniosegala/MAKO/releases/download/render-v4.0.0/MAKO-Renderer-v4.0.0-linux.tar.xz",
      "sha256hash": "72ae1202f2a649f65cb75a7d1082f7aeacb7e87c8a2d6f29888343d5271c2b7c",
      "host_architectures": [
        "x86_64"
      ],
      "flatpak_bundle": {
        "name": "MAKO-Renderer-v4.0.0-flatpaks.tar.xz",
        "url": "https://github.com/eugeniosegala/MAKO/releases/download/render-v4.0.0/MAKO-Renderer-v4.0.0-flatpaks.tar.xz",
        "sha256hash": "3159f6909f318f2c0b47c68336423ec9b3f8efa8e3c7d30ae4ecc5d9b41ac5cf"
      },
      "arch_package": {
        "name": "mako-renderer-bin-4.0.0-1-x86_64.pkg.tar.zst",
        "url": "https://github.com/eugeniosegala/MAKO/releases/download/render-v4.0.0/mako-renderer-bin-4.0.0-1-x86_64.pkg.tar.zst",
        "sha256hash": "286656b72909698055ec12fbe0999334692dad801e2f2c034f51c1293d0af97d"
      }
    }
  ]
}

; GFG Shell — Godot 4 project. Engine configuration only; logic lives in scripts/.
config_version=5

[application]

config/name="GFG Shell"
config/description="Controller-first game shell for Steam Deck; Steam stays the game client."
config/version="0.2.2"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4")
run/low_processor_mode=true
boot_splash/bg_color=Color(0.039, 0.039, 0.051, 1)
boot_splash/show_image=false

[autoload]

Shell="*res://scripts/core/shell_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
environment/defaults/default_clear_color=Color(0.039, 0.039, 0.051, 1)

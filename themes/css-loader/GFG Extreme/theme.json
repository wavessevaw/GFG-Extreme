{
  "manifest_version": 8,
  "name": "GFG Extreme",
  "version": "v1.0",
  "author": "GFG Extreme",
  "target": "System-Wide",
  "description": "The GFG Extreme look for the whole Deck UI: near-black, graphite surfaces and one red accent.",
  "inject": {
    "shared.css": ["SP", "QuickAccess", "MainMenu"]
  },
  "patches": {
    "Accent": {
      "default": "GFG Red",
      "type": "dropdown",
      "values": {
        "GFG Red": { "accent-red.css": ["SP", "QuickAccess", "MainMenu"] },
        "Ember": { "accent-ember.css": ["SP", "QuickAccess", "MainMenu"] },
        "Crimson": { "accent-crimson.css": ["SP", "QuickAccess", "MainMenu"] }
      }
    },
    "Background": {
      "default": "Black",
      "type": "dropdown",
      "values": {
        "Black": { "bg-black.css": ["SP", "QuickAccess", "MainMenu"] },
        "Graphite": { "bg-graphite.css": ["SP", "QuickAccess", "MainMenu"] }
      }
    },
    "Red focus glow": {
      "default": "Yes",
      "type": "checkbox",
      "values": {
        "Yes": { "focus-glow.css": ["SP", "QuickAccess", "MainMenu"] },
        "No": {}
      }
    }
  }
}

#version 450
layout(local_size_x=8,local_size_y=8)in;
layout(std140,binding=0)uniform Params{uvec4 size;vec4 timing;}p;
layout(rgba8,binding=48)readonly uniform image2D previousImage;
layout(rgba8,binding=49)readonly uniform image2D currentImage;
layout(rgba32f,binding=50)writeonly uniform image2D previousPyramid;
layout(rgba32f,binding=51)writeonly uniform image2D currentPyramid;
void main(){
 ivec2 q=ivec2(gl_GlobalInvocationID.xy),extent=(ivec2(p.size.xy)+3)/4;
 if(any(greaterThanEqual(q,extent)) || p.timing.w>0)return;
 vec4 a=vec4(0),b=vec4(0);
 for(int y=0;y<4;y++)for(int x=0;x<4;x++){
  ivec2 s=min(q*4+ivec2(x,y),ivec2(p.size.xy)-1);
  if(p.timing.z>0)a+=imageLoad(previousImage,s);
  b+=imageLoad(currentImage,s);
 }
 imageStore(previousPyramid,q,a/16);
 imageStore(currentPyramid,q,b/16);
}

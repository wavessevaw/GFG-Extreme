#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(std140,binding=0) uniform Params { uvec4 size; vec4 timing; } p;
layout(rgba8,binding=48) readonly uniform image2D previousImage;
layout(rgba8,binding=49) readonly uniform image2D currentImage;
layout(rgba32f,binding=50) readonly uniform image2D coarseForward;
layout(rgba32f,binding=51) readonly uniform image2D coarseBackward;
layout(rgba32f,binding=52) writeonly uniform image2D refinedForward;
layout(rgba32f,binding=53) writeonly uniform image2D refinedBackward;
vec3 fetch(bool back,ivec2 q){
 q=clamp(q,ivec2(0),ivec2(p.size.xy)-1);
 return back?imageLoad(currentImage,q).rgb:imageLoad(previousImage,q).rgb;
}
float cost(bool back,ivec2 q,ivec2 d){
 float e=0;
 for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){
  ivec2 a=q+ivec2(x,y)*2;
  e+=dot(abs(fetch(back,a)-fetch(!back,a+d)),vec3(.299,.587,.114));
 }
 return e/9;
}
vec4 refine(bool back,ivec2 b){
 vec4 c=back?imageLoad(coarseBackward,b):imageLoad(coarseForward,b);
 // Confident/static regions take only the inexpensive transfer path.
 if(c.z<.0025 && c.w>.7)return c;
 ivec2 stride=(ivec2(p.size.xy)+ivec2(p.size.zw)-1)/ivec2(p.size.zw);
 ivec2 q=min(b*stride+stride/2,ivec2(p.size.xy)-1);
 ivec2 seed=ivec2(round(c.xy)),bestD=seed;
 float best=cost(back,q,seed),second=1e10;
 for(int y=-3;y<=3;y++)for(int x=-3;x<=3;x++){
  ivec2 d=seed+ivec2(x,y);float e=cost(back,q,d);
  if(e<best){second=best;best=e;bestD=d;}
  else if(d!=bestD)second=min(second,e);
 }
 // A coarse winner can be aliased on highly detailed colour-only inputs.
 // Always compare small local motion too; never let a bad coarse proposal
 // prevent an exact near-zero correspondence from being found.
 if(any(notEqual(seed,ivec2(0)))) {
  for(int y=-3;y<=3;y++)for(int x=-3;x<=3;x++){
   ivec2 d=ivec2(x,y);
   if(all(lessThanEqual(abs(d-seed),ivec2(3))))continue;
   float e=cost(back,q,d);
   if(e<best){second=best;best=e;bestD=d;}
   else if(d!=bestD)second=min(second,e);
  }
 }
 // A plausible coarse match with a bad fine residual is a difficult tile.
 // Spend the wide full-resolution search only there. Large scene cuts
 // (bad coarse residual too) take the conservative real-frame fallback.
 if(c.z<.10 && best>.0025){
  int comparisons=0,exactComparisons=0;
  for(int y=-16;y<=16 && best>.001;y+=2)for(int x=-16;x<=16 && best>.001;x+=2){
   ivec2 d=ivec2(x,y);
   float quick=dot(abs(fetch(back,q-ivec2(2))-fetch(!back,q-ivec2(2)+d)),vec3(.299,.587,.114));
   quick+=dot(abs(fetch(back,q+ivec2(2))-fetch(!back,q+ivec2(2)+d)),vec3(.299,.587,.114));
   if(quick*.5>best*.5+.0025)continue;
   // Bound expensive nine-sample comparisons. Reserve four probes for
   // virtually exact two-sample matches, which preserve clean translation.
   if(comparisons>=32){
    if(quick>.001 || exactComparisons>=4)continue;
    exactComparisons++;
   }else comparisons++;
   float e=cost(back,q,d);
   if(e<best){second=best;best=e;bestD=d;}
   else if(d!=bestD)second=min(second,e);
  }
 }
 // The bounded wide lattice is two pixels apart; polish its winner once.
 if(bestD!=seed && best>.001){
  ivec2 centre=bestD;
  for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){
   ivec2 d=centre+ivec2(x,y);float e=cost(back,q,d);
   if(e<best){second=best;best=e;bestD=d;}
   else if(d!=bestD)second=min(second,e);
  }
 }
 float residual=1-smoothstep(.015,.09,best);
 float unique=clamp((second-best)/max(second,.001),0,1);
 // Low uniqueness gets conservative confidence, even with low residual.
 return vec4(bestD,best,residual*max(unique,.05));
}
void main(){
 ivec2 b=ivec2(gl_GlobalInvocationID.xy);
 if(any(greaterThanEqual(b,ivec2(p.size.zw))))return;
 if(p.timing.z==0 || p.timing.w>0){imageStore(refinedForward,b,vec4(0,0,1,0));imageStore(refinedBackward,b,vec4(0,0,1,0));return;}
 imageStore(refinedForward,b,refine(false,b));
 imageStore(refinedBackward,b,refine(true,b));
}

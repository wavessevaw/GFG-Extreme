#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(std140,binding=0) uniform Params { uvec4 size; vec4 timing; } p;
layout(rgba8,binding=48) readonly uniform image2D previousImage;
layout(rgba8,binding=49) readonly uniform image2D currentImage;
layout(rgba32f,binding=50) writeonly uniform image2D forwardFlow;
layout(rgba32f,binding=51) writeonly uniform image2D backwardFlow;
layout(rgba32f,binding=52) readonly uniform image2D historyForward;
layout(rgba32f,binding=53) readonly uniform image2D historyBackward;
vec3 fetch(bool back,ivec2 q) {
 q=clamp(q,ivec2(0),ivec2(p.size.xy)-1);
 return back?imageLoad(currentImage,q).rgb:imageLoad(previousImage,q).rgb;
}
float cost(bool back,ivec2 q,ivec2 d) {
 float e=0;
 for(int y=0;y<2;y++) for(int x=0;x<2;x++) {
  ivec2 a=q+ivec2(x*4-2,y*4-2);
  e+=dot(abs(fetch(back,a)-fetch(!back,a+d)),vec3(.299,.587,.114));
 }
 return e*.25;
}
vec4 solve(bool back,ivec2 block) {
 ivec2 q=min(block*8+ivec2(4),ivec2(p.size.xy)-1);
 float stationary=cost(back,q,ivec2(0));
 // Exact/static tiles never run the search. Textureless motion remains
 // ambiguous and will use a real frame rather than fabricate a contour.
 if(stationary<.0025) return vec4(0,0,stationary,1);
 ivec2 bestD=ivec2(0); float best=stationary,second=1e10;
 if(p.timing.y>0 && stationary<.16) {
  vec4 old=back?imageLoad(historyBackward,block):imageLoad(historyForward,block);
  if(old.w>.5) {
   ivec2 d=ivec2(round(old.xy));
   float e=cost(back,q,d);
   if(e<best){second=best;best=e;bestD=d;}
  }
 }
 for(int y=-4;y<=4;y++) for(int x=-4;x<=4;x++){
  ivec2 d=ivec2(x,y)*4;
  float e=cost(back,q,d);
  if(e<best){second=best;best=e;bestD=d;}
  else if(d!=bestD) second=min(second,e);
 }
 float uniqueness=clamp((second-best)/max(second,.001),0,1);
 return vec4(bestD,best,uniqueness);
}
void main(){
 ivec2 b=ivec2(gl_GlobalInvocationID.xy);
 if(any(greaterThanEqual(b,ivec2(p.size.zw))))return;
 if(p.timing.z==0){imageStore(forwardFlow,b,vec4(0,0,1,0));imageStore(backwardFlow,b,vec4(0,0,1,0));return;}
 imageStore(forwardFlow,b,solve(false,b));
 imageStore(backwardFlow,b,solve(true,b));
}

#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(std140,binding=0) uniform Params { uvec4 size; vec4 timing; } p;
layout(rgba8,binding=48) readonly uniform image2D previousImage;
layout(rgba8,binding=49) readonly uniform image2D currentImage;
layout(rgba32f,binding=50) readonly uniform image2D forwardFlow;
layout(rgba32f,binding=51) readonly uniform image2D backwardFlow;
layout(rgba8,binding=52) writeonly uniform image2D outputImage;
vec4 flow(bool back,vec2 q){
 ivec2 b=clamp(ivec2(q)/8,ivec2(0),ivec2(p.size.zw)-1);
 return back?imageLoad(backwardFlow,b):imageLoad(forwardFlow,b);
}
vec4 sampleImage(bool back,vec2 q){
 q=clamp(q,vec2(0),vec2(p.size.xy)-1);
 ivec2 a=ivec2(floor(q)),b=min(a+1,ivec2(p.size.xy)-1);
 vec2 f=fract(q);
 vec4 v00=back?imageLoad(currentImage,a):imageLoad(previousImage,a);
 vec4 v10=back?imageLoad(currentImage,ivec2(b.x,a.y)):imageLoad(previousImage,ivec2(b.x,a.y));
 vec4 v01=back?imageLoad(currentImage,ivec2(a.x,b.y)):imageLoad(previousImage,ivec2(a.x,b.y));
 vec4 v11=back?imageLoad(currentImage,b):imageLoad(previousImage,b);
 return mix(mix(v00,v10,f.x),mix(v01,v11,f.x),f.y);
}
bool inside(vec2 q){return all(greaterThanEqual(q,vec2(0)))&&all(lessThanEqual(q,vec2(p.size.xy)-1));}
void main(){
 ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
 if(any(greaterThanEqual(pixel,ivec2(p.size.xy))))return;
 vec2 q=vec2(pixel);float t=p.timing.x;
 vec4 f=flow(false,q),b=flow(true,q);
 // Fixed-point inverse mapping avoids using a source-space vector directly
 // at the interpolated position.
 vec2 a=q-f.xy*t,c=q-b.xy*(1-t);
 f=flow(false,a);b=flow(true,c);
 a=q-f.xy*t;c=q-b.xy*(1-t);
 vec4 A=sampleImage(false,a),B=sampleImage(true,c);
 vec4 oppositeA=flow(true,a+f.xy),oppositeB=flow(false,c+b.xy);
 bool validA=inside(a)&&f.z<.08&&length(f.xy+oppositeA.xy)<2.5;
 bool validB=inside(c)&&b.z<.08&&length(b.xy+oppositeB.xy)<2.5;
 float disagreement=dot(abs(A.rgb-B.rgb),vec3(.299,.587,.114));
 // Occlusion/disocclusion and scene discontinuities never mix mismatched
 // contours. Single-sided reconstruction, then nearest real frame fallback.
 vec4 outColor;
 if(p.timing.y==0)outColor=sampleImage(true,q);
 else if(validA&&validB&&disagreement<.045)outColor=mix(A,B,t);
 else if(validA&&!validB)outColor=A;
 else if(validB&&!validA)outColor=B;
 else outColor=sampleImage(t>=.5,q);
 imageStore(outputImage,pixel,outColor);
}

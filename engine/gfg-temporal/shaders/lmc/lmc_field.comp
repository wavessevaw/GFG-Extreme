#version 450
#extension GL_GOOGLE_include_directive : require
// Per-pixel vectors at half resolution for one grid (reference:
// gen_lmc2.half_field).  One workgroup per level-1 block (4x4 half pixels).
// Block-constant candidates are evaluated once over a 6x6 LDS apron; the
// camera layers vary per pixel and are evaluated in place.
//
// PC.grid: 0 = B grid (own B, other A, sign -1), 1 = A grid (own A, other B, +1)
// PC.pass_: 0 = without orphans; 1 = with orphans, only blocks next to one
#include "lmc_common.glsl"
#include "lmc_store.glsl"
layout(local_size_x = 64) in;

#define MAXC 24
shared vec2 s_c[MAXC];        // block-constant candidates (half px)
shared int s_order[MAXC + 8]; // evaluation order: >= 0 block-constant, < 0 layer -(k+1)
shared int s_n;
shared vec3 s_own[36];
shared vec3 s_oth[36];
shared float s_best_c[16];
shared vec2 s_best_v[16];

void main() {
    int grid = PC.grid;
    ivec2 nb = lblocks(1);
    int id = int(gl_WorkGroupID.x);
    ivec2 bb = ivec2(id % nb.x, id / nb.x);
    uint lid = gl_LocalInvocationIndex;
    ivec2 hs = P.size.zw;
    float sgn = grid == 0 ? -1.0 : 1.0;
    int own_which = grid == 0 ? 1 : 0, oth_which = grid == 0 ? 0 : 1;

    if (lid == 0u) {
        // reference block_cands order: (dy, dx) over (0, -1, 1) x (0, -1, 1)
        const int O[3] = int[3](0, -1, 1);
        vec2 list[MAXC];
        int n = 0;
        vec2 own_v = vec2(0.0);
        bool any_orphan = false;
        for (int a = 0; a < 3; ++a)
            for (int c = 0; c < 3; ++c) {
                ivec2 q = clamp(bb + ivec2(O[c], O[a]), ivec2(0), nb - 1);
                vec4 v = grid == 0 ? vb[P.blk_off.x + q.y * nb.x + q.x] : va[P.blk_off.x + q.y * nb.x + q.x];
                list[n++] = v.xy;  // level-1 px == half px
                if (n == 1) own_v = v.xy;
                if (orphan_at(grid, q.y * nb.x + q.x).z > 0.5) any_orphan = true;
            }
        if (PC.pass_ == 1) {
            uint cnt = grid == 0 ? G.orphans_b : G.orphans_a;
            if (cnt > 0u) {
                for (int a = 0; a < 3; ++a)
                    for (int c = 0; c < 3; ++c) {
                        ivec2 q = clamp(bb + ivec2(O[c], O[a]), ivec2(0), nb - 1);
                        vec4 o = orphan_at(grid, q.y * nb.x + q.x);
                        list[n++] = o.z > 0.5 ? o.xy * 0.5 : own_v;
                    }
            }
        }
        // evaluation order with duplicates of block-constant entries removed
        int m = 0, k = 0;
        for (int i = 0; i < n; ++i) {
            bool dup = false;
            for (int j = 0; j < i; ++j) if (list[j] == list[i]) dup = true;
            s_c[i] = list[i];
            if (!dup) s_order[k++] = i;
        }
        m = n;
        for (int L = 0; L < int(LY.layer_count); ++L) s_order[k++] = -(L + 1);
        for (int q = 0; q < int(G.pal_count); ++q) {
            vec2 pv = G.palette[q].xy * 0.5;
            bool dup = false;
            for (int j = 0; j < m; ++j) if (s_c[j] == pv) dup = true;
            s_c[m] = pv;
            if (!dup) s_order[k++] = m;
            ++m;
        }
        bool dup0 = false;
        for (int j = 0; j < m; ++j) if (s_c[j] == vec2(0.0)) dup0 = true;
        s_c[m] = vec2(0.0);
        if (!dup0) s_order[k++] = m;
        s_n = (PC.pass_ == 1 && !any_orphan) ? -1 : k;
    }
    if (lid < 36u) {
        ivec2 a = clamp(bb * 4 + ivec2(int(lid % 6u), int(lid / 6u)) - 1, ivec2(0), hs - 1);
        s_own[lid] = half_rgb(own_which, vec2(a));
    }
    if (lid < 16u) s_best_c[lid] = 1e30;
    barrier();
    if (s_n < 0) return;  // pass 1: no orphan near this block, the pass-0 field stands

    ivec2 me = bb * 4 + ivec2(int(lid % 4u), int(lid / 4u));
    for (int e = 0; e < s_n; ++e) {
        int o = s_order[e];
        if (o >= 0) {
            vec2 v = s_c[o];
            if (lid < 36u) {
                ivec2 a = bb * 4 + ivec2(int(lid % 6u), int(lid / 6u)) - 1;
                s_oth[lid] = half_rgb(oth_which, vec2(a) + sgn * v);
            }
            barrier();
            if (lid < 16u) {
                vec2 cen = vec2(me) + sgn * v;
                float c = 0.0;
                for (int dy = -1; dy <= 1; ++dy)
                    for (int dx = -1; dx <= 1; ++dx) {
                        int ai = (int(lid / 4u) + 1 + dy) * 6 + int(lid % 4u) + 1 + dx;
                        // own uses the clamped window pixel, other the unclamped offset
                        vec3 d = abs(s_own[ai] - s_oth[ai]);
                        c += d.r + d.g + d.b;
                    }
                c = c / 9.0 + (o == 0 ? 0.0 : P.margin);
                if (!inside(cen, hs)) c = 1e30;
                if (c < s_best_c[lid]) { s_best_c[lid] = c; s_best_v[lid] = v; }
            }
            barrier();
        } else if (lid < 16u) {
            Layer Lr = LY.layers[-o - 1];
            Layer Li = inv_h(Lr);
            vec2 v = camera_vec(Lr, Li, vec2(me), 2.0, grid);
            vec2 cen = vec2(me) + sgn * v;
            float c = 0.0;
            for (int dy = -1; dy <= 1; ++dy)
                for (int dx = -1; dx <= 1; ++dx) {
                    int ai = (int(lid / 4u) + 1 + dy) * 6 + int(lid % 4u) + 1 + dx;
                    vec3 d = abs(s_own[ai] - half_rgb(oth_which, cen + vec2(dx, dy)));
                    c += d.r + d.g + d.b;
                }
            c = c / 9.0 + P.margin;
            if (!inside(cen, hs)) c = 1e30;
            if (c < s_best_c[lid]) { s_best_c[lid] = c; s_best_v[lid] = v; }
        }
    }
    barrier();
    if (lid < 16u && all(lessThan(me, hs))) {
        // HUD: reference half(hud) > 0.5, i.e. at least 3 of the 4 full-res pixels
        uint h = 0u;
        for (int k = 0; k < 4; ++k) {
            ivec2 f = me * 2 + ivec2(k & 1, k >> 1);
            if (imageLoad(hudCount, f).r >= uint(P.hud_pairs)) h += 1u;
        }
        vec2 v = h >= 3u ? vec2(0.0) : s_best_v[lid];
        vec4 outv = vec4(v, s_best_c[lid], 0.0);
        if (grid == 0) imageStore(storeFieldB, me, outv); else imageStore(storeFieldA, me, outv);
    }
}

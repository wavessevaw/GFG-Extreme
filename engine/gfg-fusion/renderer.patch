+void SpatialScaler::configureDirectFrameGenerationInputs(const vk::Vulkan& vk,
+        const std::span<const std::reference_wrapper<const vk::Image>> inputs) {
+    if (inputs.size() > 64)
+        throw ls::vulkan_error("Frame Fusion input capacity exceeds 64");
+    for (size_t index = 0; index < inputs.size(); ++index) {
+        const auto& image = inputs[index].get();
+        const auto extent = image.getExtent();
+        if (extent.width != this->implementation->sourceSize.width ||
+                extent.height != this->implementation->sourceSize.height ||
+                image.getFormat() != this->implementation->workingFormat ||
+                !(image.getUsage() & VK_IMAGE_USAGE_SAMPLED_BIT))
+            throw ls::vulkan_error("Frame Fusion requires matching sampled input images");
+        for (size_t prior = 0; prior < index; ++prior)
+            if (inputs[prior].get().handle() == image.handle())
+                throw ls::vulkan_error("Frame Fusion rejects duplicate input images");
+    }
+    this->implementation->pipeline->configureDirectInputs(vk, inputs);
+    this->implementation->fusionFrames = 0;
+}
+
+void SpatialScaler::clearDirectFrameGenerationInputs() {
+    this->implementation->pipeline->clearDirectInputs();
+    this->implementation->fusionFrames = 0;
+}
+
+size_t SpatialScaler::directFrameGenerationInputCount() const {
+    return this->implementation->pipeline->directInputCount();
+}
+
+uint64_t SpatialScaler::frameFusionRecordedFrames() const {
